{
  "name": "constructa-sdk",
  "version": "0.0.2",
  "description": "The supported developer-facing API for Constructa.",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jack-WebDev/constructa.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "constructa-core": "workspace:*",
    "constructa-exporters": "workspace:*",
    "constructa-generators": "workspace:*",
    "constructa-schema": "workspace:*"
  },
  "devDependencies": {
    "@constructa/config": "workspace:*",
    "typescript": "catalog:"
  }
}
